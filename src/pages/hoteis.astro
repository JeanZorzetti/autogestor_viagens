---
import Base from "../layouts/Base.astro";
import CabecaDePortao from "../components/CabecaDePortao.astro";
import { AREA_SERVIDA, COBERTURA, FICHA, META_PORTAO, PRODUTOS, REGIMES_HTL } from "../data/conteudo";
import { EXTERNOS, SITE, whatsapp } from "../consts";

const produto = PRODUTOS.find((p) => p.codigo === "HTL")!;
const { titulo, descricao, bluf } = META_PORTAO.HTL;
const AJUDA = whatsapp("Olá! Estou comprando hospedagem pelo site e preciso de ajuda.");

const site = new URL(SITE.url);
const abs = (p: string) => new URL(p, site).href;
const servicoSchema = {
  "@type": "Service",
  "@id": `${abs(produto.rota)}#servico`,
  serviceType: produto.nome,
  name: titulo,
  description: bluf,
  provider: { "@id": abs("/#agencia") },
  areaServed: AREA_SERVIDA,
  url: abs(produto.rota),
};
---

<Base
  titulo={titulo}
  descricao={descricao}
  schema={[servicoSchema]}
  trilha={[
    { nome: "Início", href: "/" },
    { nome: produto.nome, href: produto.rota },
  ]}
>
  <article class="portao">
    <CabecaDePortao produto={produto} titulo={produto.nome} bluf={bluf} />

    <div class="container">
      <section class="portao__secao">
        <h2 class="portao__secao-titulo">O que esta busca cobre</h2>
        <ul class="cobertura">
          {COBERTURA.HTL.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="portao__secao">
        <h2 class="portao__secao-titulo">Os quatro regimes de hospedagem</h2>
        <ul class="detalhe--estados">
          {
            REGIMES_HTL.map((r) => (
              <li>
                <h3>{r.regime}</h3>
                <p>{r.oQueInclui}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="portao__secao">
        <h2 class="portao__secao-titulo">Ficha</h2>
        <ul class="ficha">
          {
            FICHA.HTL.map((item) => (
              <li class="ficha__item">
                <span class="ficha__rotulo">{item.rotulo}</span>
                <span>
                  <span class="ficha__valor">{item.valor}</span>
                  {item.fonte && (
                    <a class="ficha__fonte" href={item.fonte.href}>
                      {item.fonte.texto}
                    </a>
                  )}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <nav class="portao__outros" aria-label="Outros produtos">
        {PRODUTOS.filter((p) => p.codigo !== produto.codigo).map((p) => <a href={p.rota}>{p.nome}</a>)}
      </nav>

      <section class="portao__acao">
        <p class="portao__acao-lead">
          A busca abre numa aba nova, na plataforma de reservas — o visual muda, e é esperado. Lá dentro você escolhe
          <strong> Hotéis</strong> e segue com a reserva.
        </p>
        <a class="btn btn--primario" href={EXTERNOS.busca} target="_blank" rel="noopener">
          Abrir a busca<span class="visualmente-oculto"> — nova aba, na plataforma de reservas</span>
        </a>
        <p class="depois-do-btn">
          Dúvida no meio da compra?
          <a href={AJUDA} target="_blank" rel="noopener">
            Chame no WhatsApp<span class="visualmente-oculto"> — abre em nova aba</span></a
          >.
        </p>
      </section>
    </div>
  </article>
</Base>
