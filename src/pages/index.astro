---
import Base from "../layouts/Base.astro";
import Foto from "../components/Foto.astro";
import { CONCORRENTES, PASSOS, PERGUNTAS, PRODUTOS, RAZOES } from "../data/conteudo";
import { ATENDIMENTO, EMPRESA, EXTERNOS, whatsapp } from "../consts";
import creditos from "../../public/img/FOTOS.json";

const BUSCA = EXTERNOS.busca;
const AJUDA = whatsapp("Olá! Estou comprando pelo site de viagens e preciso de ajuda.");
const creditoAbertura = creditos.find((c) => c.nome === "saguao")!;

/* O ENQUADRAMENTO NA GRADE. O arquivo de cada peça é 4:5, e a grade mostra as
   duas da coluna larga em 5:4 — o `object-fit: cover` corta altura, e onde ele
   corta decide se a peça mostra o assunto ou o céu em cima dele. Mora aqui e
   não no manifesto de fotos porque é propriedade da PEÇA (de como a imagem é
   exibida nesta grade), não do arquivo: a mesma foto entra na abertura do
   portão em 16:9 e pede outro corte. */
const FOCO_NA_GRADE: Record<string, string> = {
  aer: "50% 58%", // a asa e a linha do horizonte moram abaixo do meio
  htl: "50% 50%", // 4:5 nativo na coluna estreita — não há corte a decidir
  pct: "50% 50%", // idem
  car: "50% 82%", // a estrada é o assunto, e ela está no terço de baixo
};

const titulo = "Passagens aéreas, hotéis e pacotes em até 12x | Autogestor Viagens";
const descricao =
  "Busque, compare e emita você mesmo: passagens aéreas nacionais e internacionais, hotéis, pacotes e aluguel de carro, com promoções diárias e pagamento em até 12x no cartão.";

/* O FAQ da página e o FAQPage do JSON-LD saem da MESMA lista. Manter os dois à
   mão é como uma das duas versões envelhece sem ninguém perceber — e a que
   envelhece costuma ser a que o buscador lê. */
const faqSchema = {
  "@type": "FAQPage",
  "@id": "#faq",
  mainEntity: PERGUNTAS.map((q) => ({
    "@type": "Question",
    name: q.p,
    acceptedAnswer: { "@type": "Answer", text: q.r },
  })),
};
---

<Base titulo={titulo} descricao={descricao} schema={[faqSchema]}>
  {/* ══ A ABERTURA ══════════════════════════════════════════════════════════
      A janela. A fotografia ocupa a tela inteira em cor cheia, o véu fecha do
      horizonte para baixo, e o título pousa no peitoril.

      O H1 e a fotografia NÃO animam: os dois são o elemento de LCP e já estão
      no primeiro quadro pintado. O que entra pela fresta é a lâmina de texto
      abaixo deles — é a regra "o resto chega em volta do LCP", não economia de
      código.

      `alt=""` e não uma descrição: a foto não carrega informação que o H1 ao
      lado já não dê. Um alt de "pessoas olhando aviões pela janela do
      aeroporto" seria ruído lido em voz alta antes do título — decoração
      descrita é pior para leitor de tela do que decoração declarada como tal.
      O crédito do autor fica visível no canto, e em public/img/FOTOS.json. */}
  <section class="abertura">
    <Foto nome="saguao" alt="" sizes="100vw" prioridade classe="abertura__foto" />
    <div class="abertura__veu" aria-hidden="true"></div>

    <div class="container abertura__peitoril">
      <h1 class="abertura__titulo">
        Pesquise onde quiser.<br /><em>Compare aqui.</em>
      </h1>

      <div class="entra" style="--atraso: 120">
        <div>
          <p class="abertura__chamada">
            Passagem aérea, hotel, pacote e aluguel de carro na mesma busca, no Brasil e no exterior, em
            <strong>até 12x no cartão</strong>. Promoções novas todo dia, e a compra fechada por você — sem esperar
            cotação de ninguém.
          </p>

          <p class="abertura__acao">
            <a class="btn btn--primario" href={BUSCA} target="_blank" rel="noopener">
              Buscar minha viagem<span class="visualmente-oculto"> — nossa busca online, abre em nova aba</span>
            </a>
            <span class="abertura__nota">
              Grátis para pesquisar, sem cadastro. A busca abre em nova aba, na plataforma de reservas.
            </span>
          </p>
        </div>
      </div>
    </div>

    <p class="abertura__credito">
      Foto <a href={creditoAbertura.pagina} target="_blank" rel="noopener">
        {creditoAbertura.autor}<span class="visualmente-oculto"> no Unsplash — abre em nova aba</span></a
      >
    </p>
  </section>

  {/* ══ SEM JAVASCRIPT — O ÓRFÃO DA VITRINE É RESOLVIDO EM CSS ═══════════════
      Havia aqui um script inline (~200 bytes) que apagava, no clique, o
      `view-transition-name` das três fotografias não escolhidas — porque
      elas ficam sem par no documento do portão e o navegador resolve órfão
      com o fade padrão dele.

      Ele só cobria METADE do problema: resolvia a IDA (capa → portão), mas
      não a VOLTA. No caminho inverso é o portão que sai com um nome só, e são
      as fotografias da CAPA — o documento que ENTRA — que chegam órfãs; um
      script disparado pelo clique dentro da capa nunca roda nessa direção.
      `npm run verificar` mediu isso nas duas direções (T051) e pegou o furo.

      A correção que cobre as duas direções é `::view-transition-old(*):
      only-child` em global.css: um nome sem par vira filho único do próprio
      par (`::view-transition-image-pair`), e a regra desliga a animação sem
      saber qual documento é a origem. Zero JavaScript, zero script inline —
      e esta agora é, de fato, uma das oito rotas com zero. */}

  {/* ══ A VITRINE ═══════════════════════════════════════════════════════════
      Os quatro produtos, cada um com a fotografia do que ele vende. A célula
      inteira é o link — não há botão dentro dela.

      A fotografia carrega um `view-transition-name` por produto: é ela que
      atravessa para a abertura do portão quando a pessoa clica, e o par
      homônimo está em CabecaDePortao.astro. Nome por CÓDIGO de produto, não
      genérico: precisa ser único dentro de cada documento e existir nos dois. */}
  <section class="vitrine">
    <div class="container">
      <div class="vitrine__cabeca">
        <h2 class="vitrine__titulo">Quatro buscas, uma compra</h2>
        <p class="vitrine__nota">
          Cada uma explica o que essa busca cobre antes de você abrir a plataforma de reservas.
        </p>
      </div>

      <ol class="vitrine__grade">
        {
          PRODUTOS.map((p) => {
            const foto = p.codigo.toLowerCase();
            return (
              <li>
                <a class="peca abre" href={p.rota}>
                  <Foto
                    nome={foto}
                    alt=""
                    sizes="(min-width: 46rem) 46vw, 92vw"
                    estilo={`view-transition-name: vt-${foto}; --foco-foto: ${FOCO_NA_GRADE[foto]};`}
                  />
                  <span class="peca__veu" aria-hidden="true" />
                  <span class="peca__legenda">
                    <span class="peca__codigo">{p.codigo}</span>
                    <span class="peca__nome">{p.nome}</span>
                    <span class="peca__nota">{p.nota}</span>
                    <span class="peca__seta">{p.onde}</span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  {/* ══ 01 ══════════════════════════════════════════════════════════════════ */}
  <section class="secao">
    <div class="container">
      <div class="secao__cabeca">
        <div>
          <span class="secao__num" aria-hidden="true">01</span>
          <h2 class="secao__titulo">Compare antes de fechar</h2>
        </div>
        <div>
          <p class="secao__chamada">
            Você já ia abrir os outros de qualquer jeito. Abra — e antes de clicar em comprar, rode a mesma busca
            aqui. É um minuto para descobrir se a mesma viagem sai por menos.
          </p>
          {/* Nomes em tipografia, nunca logotipo: são marcas registradas de
              terceiros e não há ativo licenciado neste repositório. */}
          <ul class="rivais">
            {CONCORRENTES.map((c) => <li>{c}</li>)}
            <li aria-hidden="true">…</li>
            <li>e o site da própria companhia</li>
          </ul>
        </div>
      </div>

      <ol class="itens">
        {
          RAZOES.map((r) => (
            <li class="abre">
              <h3>{r.titulo}</h3>
              <p>{r.texto}</p>
            </li>
          ))
        }
      </ol>

      <div class="acao-secao">
        <a class="btn btn--contorno" href={BUSCA} target="_blank" rel="noopener">
          Buscar minha viagem<span class="visualmente-oculto"> — nossa busca online, abre em nova aba</span>
        </a>
        <p class="depois-do-btn">A busca abre em nova aba, na plataforma de reservas.</p>
      </div>
    </div>
  </section>

  {/* ══ 02 ══════════════════════════════════════════════════════════════════ */}
  <section class="secao">
    <div class="container">
      <div class="secao__cabeca">
        <div>
          <span class="secao__num" aria-hidden="true">02</span>
          <h2 class="secao__titulo">Três passos, do jeito que você já compra tudo</h2>
        </div>
        <div>
          <p class="secao__chamada">
            Do primeiro clique ao bilhete no e-mail, sem depender de alguém confirmar do outro lado.
          </p>
        </div>
      </div>

      <ol class="itens">
        {
          PASSOS.map((p) => (
            <li class="abre">
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ══ 03 ══════════════════════════════════════════════════════════════════ */}
  <section class="secao">
    <div class="container">
      <div class="secao__cabeca">
        <div>
          <span class="secao__num" aria-hidden="true">03</span>
          <h2 class="secao__titulo">Perguntas</h2>
        </div>
        <div>
          <p class="secao__chamada">
            As mesmas que chegam no {EMPRESA.telefoneExibicao}. Se a sua não estiver aqui, mande — o WhatsApp responde
            {" "}{ATENDIMENTO.prazo}.
          </p>
        </div>
      </div>

      {/* <details> nativo: abre sem JS, o teclado já funciona sem uma linha de
          ARIA e o navegador consegue encontrar texto dentro do que está
          fechado. Um acordeão em JS aqui seria trabalho para reimplementar o
          que o elemento já faz. */}
      <div class="faq">
        {
          PERGUNTAS.map((q) => (
            <details>
              <summary>{q.p}</summary>
              <div class="faq__r">
                <p>{q.r}</p>
                {"fonte" in q && q.fonte && (
                  <a class="faq__fonte" href={q.fonte.href} target="_blank" rel="noopener">
                    {q.fonte.texto}
                    <span class="visualmente-oculto"> — abre em nova aba</span>
                  </a>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* ══ FECHO ═══════════════════════════════════════════════════════════════ */}
  <section class="fecho">
    <div class="container fecho__grade">
      <div>
        <h2>Sua próxima viagem começa aqui</h2>
        <p>
          {EMPRESA.nome} é a frente de turismo do Grupo Autogestor, que atua desde {EMPRESA.fundacao} em Goiânia. A
          busca é sua e roda sozinha; quando precisar de gente, o {EMPRESA.telefoneExibicao} atende
          {" "}{ATENDIMENTO.horarioCurto}.
        </p>
        <p>
          <a href="/sobre">Quem opera este site e quem emite a reserva</a>
        </p>
      </div>

      <div class="fecho__caixa">
        <h3>Escolha seu destino agora</h3>
        <p>Voos, hotéis, pacotes e carros — Brasil e exterior, em até 12x no cartão.</p>
        <a class="btn btn--primario btn--bloco" href={BUSCA} target="_blank" rel="noopener">
          Buscar minha viagem<span class="visualmente-oculto"> — nossa busca online, abre em nova aba</span>
        </a>
        <p class="depois-do-btn">
          A busca abre em nova aba, na plataforma de reservas. Dúvida no meio da compra?
          <a href={AJUDA} target="_blank" rel="noopener">
            Chame no WhatsApp<span class="visualmente-oculto"> — abre em nova aba</span></a
          >.
        </p>
      </div>
    </div>
  </section>
</Base>
