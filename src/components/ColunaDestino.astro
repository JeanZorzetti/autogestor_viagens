---
/** A coluna que vira, com a GRAVURA do lugar na face de cada pá.
 *
 *  Este componente não é novo: é o mesmo bloco `.coluna-destino__janela` +
 *  N × `.coluna-destino__pa` que estava escrito 5× à mão (uma vez em
 *  Linha.astro e quatro em CabecaDePortao.astro, um por objeto de cabeça).
 *  Ele foi extraído aqui porque a figura precisa entrar em UM lugar, não em
 *  cinco — cinco cópias de uma regra é a forma mais barata de uma delas
 *  envelhecer sozinha.
 *
 *  A gravura é o contorno REAL do lugar (Natural Earth 1:50m para país,
 *  malha oficial do IBGE para as macrorregiões), gerado por
 *  logos/gerar-mapas.mjs. Ela não é um quinto gesto: é MATÉRIA, como o grão
 *  e o vinco. A figura vira porque a pá vira — o verbo continua sendo um só. */
import { MAPA_DE } from "../data/mapas";

interface Props {
  destinos: readonly string[];
  /** `--n`, `--ciclo-nome`, `--sombra-nome` e, quando houver, `--linha` e o
   *  `view-transition-name` do par de transição de rota. */
  estilo: string;
  classe?: string;
}

const { destinos, estilo, classe } = Astro.props;

/* Falha o BUILD, não a tela. Um destino sem contorno renderizaria
   `background-image: var(--mapa-)`, que é uma declaração inválida e some em
   silêncio: a pá ficaria lisa e ninguém saberia por quê. */
const semMapa = destinos.filter((d) => !MAPA_DE[d]);
if (semMapa.length) {
  throw new Error(
    `destino sem contorno em src/data/mapas.ts: ${semMapa.join(", ")}. ` +
      `Rode \`npm run mapas\` depois de mexer na lista de destinos.`,
  );
}
---

<span class:list={["coluna-destino__janela", classe]} aria-hidden="true" style={estilo}>
  {
    destinos.map((d, i) => (
      <span class="coluna-destino__pa vinco" style={`--i:${i}; --mapa: var(${MAPA_DE[d]})`}>
        {d}
      </span>
    ))
  }
</span>
