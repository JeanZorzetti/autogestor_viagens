---
/** A abertura do portão: a mesma janela da capa, uma tela abaixo em escala.
 *
 *  A fotografia daqui é a MESMA que a peça correspondente da vitrine mostra na
 *  capa, e carrega o mesmo `view-transition-name` — é ela que atravessa o
 *  clique, crescendo da célula para a tela inteira. É a camada 4 da
 *  coreografia, e é o que faz a navegação parecer aproximar a janela em vez de
 *  reiniciar o mundo.
 *
 *  ─── O QUE ESTE COMPONENTE DEIXOU DE SER ────────────────────────────────
 *  Ele era a "cabeça de portão" da direção Solari: quatro objetos diferentes
 *  (`par`, `faixa`, `duasMetades`, `campoUnico`) desenhados em CSS, cada um
 *  ampliando uma pá que acabava de travar, com uma coluna de destinos girando
 *  ao lado. Eram ~110 linhas de marcação condicional e ~400 de CSS para
 *  produzir quatro variações de um gesto que a direção nova não tem.
 *
 *  A variação por rota não sumiu — mudou de matéria. Antes o que variava era a
 *  FORMA do objeto; agora é a FOTOGRAFIA, que é a matéria desta direção. Cada
 *  portão abre com a imagem do que ele vende, e quatro imagens diferentes
 *  variam mais, com menos código, do que quatro arranjos de retângulo. */
import Foto from "../components/Foto.astro";
import { PRODUTOS } from "../data/conteudo";
import creditos from "../../public/img/FOTOS.json";

interface Props {
  produto: (typeof PRODUTOS)[number];
  titulo: string;
  bluf: string;
}

const { produto, titulo, bluf } = Astro.props;
const foto = produto.codigo.toLowerCase();
const credito = creditos.find((c) => c.nome === foto)!;

/* O ENQUADRAMENTO NA ABERTURA, e ele NÃO é o mesmo da vitrine.
   O arquivo é 4:5 (retrato). Na grade da capa ele aparece em 4:5 ou 5:4; aqui
   a moldura é a largura da tela por ~74svh, o que dá algo perto de 2,6:1 — o
   `cover` escala pela largura e mostra uma FAIXA ESTREITA da altura do
   arquivo. Onde essa faixa cai decide se o portão abre com o assunto ou com o
   céu acima dele: sem estes valores, o de aluguel de carro abria com um borrão
   de nuvem e a estrada ficava fora do quadro. */
const FOCO_NA_ABERTURA: Record<string, string> = {
  aer: "50% 52%", // a linha do horizonte e a ponta da asa
  htl: "50% 38%", // a fachada acesa e a piscina moram na metade de cima
  pct: "50% 58%", // a vila na falésia, não o céu acima dela
  car: "50% 78%", // a estrada e a rocha vermelha, no terço de baixo
};
---

<header class="portao__abertura">
  {/* `alt=""`: o H1 logo abaixo diz o que a página é, e a foto é a matéria da
      direção, não informação. */}
  <Foto
    nome={foto}
    alt=""
    sizes="100vw"
    prioridade
    classe="abertura__foto"
    estilo={`view-transition-name: vt-${foto}; --foco-foto: ${FOCO_NA_ABERTURA[foto]};`}
  />
  <div class="abertura__veu" aria-hidden="true"></div>

  {/* O link de volta mora DENTRO do peitoril, não solto no alto da imagem.
      Ele já esteve lá em cima e era ilegível: no portão de hotéis o topo da
      fotografia é uma fachada iluminada, e um link em --texto-2 sobre ela não
      passa contraste nenhum. Aqui embaixo ele está na mesma faixa protegida em
      que o H1 pousa — a que logos/contraste-abertura.mjs mede. */}
  <div class="container abertura__peitoril">
    <a class="portao__volta" href="/">
      Voltar ao saguão<span class="visualmente-oculto"> — a página inicial, com os quatro produtos</span>
    </a>
    <span class="portao__codigo" aria-hidden="true">{produto.codigo}</span>
    <h1 class="portao__h1">{titulo}</h1>
    <div class="entra" style="--atraso: 120">
      <div>
        <p class="portao__bluf">{bluf}</p>
      </div>
    </div>
  </div>

  <p class="abertura__credito">
    Foto <a href={credito.pagina} target="_blank" rel="noopener">
      {credito.autor}<span class="visualmente-oculto"> no Unsplash — abre em nova aba</span></a
    >
  </p>
</header>
